// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceRole {
  ADMIN
  MEMBER
}

enum EmailProvider {
  GOOGLE
  MICROSOFT
}

enum ThreadStatus {
  ACTIVE
  NEEDS_ATTENTION
  ESCALATED
  CLOSED
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EvaluationType {
  SLA_BREACH
  NEGATIVE_TONE
  NO_REPLY
  MANUAL_REVIEW
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum CoverageStatus {
  COVERED
  UNCOVERED
}

enum SystemFolderKind {
  INBOX
  SENT_ITEMS
  DRAFTS
  JUNK_EMAIL
  DELETED_ITEMS
}

enum RuleScopeKind {
  TEAM
  ACCOUNT
  FOLDER
}

//////////////////////////////////////////////////////
// MODELS
//////////////////////////////////////////////////////
model User {
  id                   String            @id @default(uuid())
  email                String            @unique
  name                 String?
  currentPlanId        String
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  currentPlan          Plan              @relation("UserCurrentPlan", fields: [currentPlanId], references: [id])
  ownedWorkspaces      Workspace[]       @relation("WorkspaceOwner")
  teamMemberships      TeamMember[]
  workspaceMemberships WorkspaceMember[]
  emailAccounts        EmailAccount[]

  @@index([currentPlanId])
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  ownerUserId String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  owner       User              @relation("WorkspaceOwner", fields: [ownerUserId], references: [id])
  members     WorkspaceMember[]
  teams       Team[]

  @@index([ownerUserId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id])
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Team {
  id            String           @id @default(cuid())
  workspaceId   String
  name          String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  members       TeamMember[]
  rules         MonitoringRule[]
  threads       Thread[]
  emailAccounts EmailAccount[]
  folders       EmailFolder[]
  messages      Message[]
  evaluations   Evaluation[]
  alerts        Alert[]
  settings      TeamSettings?

  @@index([workspaceId])
}

model TeamMember {
  id     String   @id @default(cuid())
  userId String
  teamId String
  role   TeamRole @default(MEMBER)
  user   User     @relation(fields: [userId], references: [id])
  team   Team     @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
}

model EmailAccount {
  id               String           @id @default(cuid())
  userId           String
  teamId           String
  provider         EmailProvider
  emailAddress     String
  accessToken      String
  refreshToken     String?
  tokenExpiresAt   DateTime?
  lastSyncAt       DateTime?
  foldersDeltaLink String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id])
  team             Team             @relation(fields: [teamId], references: [id])
  threads          Thread[]
  folders          EmailFolder[]
  scopedRules      MonitoringRule[] @relation("RuleAccountScope")

  @@unique([provider, emailAddress, teamId])
}

model EmailFolder {
  id             String            @id @default(cuid())
  teamId         String
  emailAccountId String
  externalId     String
  parentId       String?
  name           String
  path           String
  isSystem       Boolean           @default(false)
  systemKind     SystemFolderKind?
  monitored      Boolean?
  isNew          Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  team         Team             @relation(fields: [teamId], references: [id])
  emailAccount EmailAccount     @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  parent       EmailFolder?     @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     EmailFolder[]    @relation("FolderHierarchy")
  messages     Message[]
  scopedRules  MonitoringRule[] @relation("RuleFolderScope")

  @@unique([emailAccountId, externalId])
  @@index([teamId])
  @@index([emailAccountId, parentId])
  @@index([emailAccountId, path])
}

model Thread {
  id                   String         @id @default(cuid())
  teamId               String
  emailAccountId       String
  externalThreadId     String
  subject              String?
  status               ThreadStatus   @default(ACTIVE)
  coverageStatus       CoverageStatus @default(COVERED)
  firstInboundAt       DateTime?
  firstOutboundAt      DateTime?
  lastInboundAt        DateTime?
  lastOutboundAt       DateTime?
  lastMessageAt        DateTime
  lastEvaluatedAt      DateTime?
  folderIds            String[]       @default([])
  firstResponseMinutes Int?
  hadLateFirstResponse Boolean        @default(false)
  dismissedAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  team                 Team           @relation(fields: [teamId], references: [id])
  emailAccount         EmailAccount   @relation(fields: [emailAccountId], references: [id])
  messages             Message[]
  evaluations          Evaluation[]
  alerts               Alert[]

  @@unique([emailAccountId, externalThreadId])
  @@index([teamId])
  @@index([status])
  @@index([folderIds], type: Gin)
}

model Message {
  id         String           @id @default(cuid())
  teamId     String
  threadId   String
  externalId String // Gmail messageId
  direction  MessageDirection
  sender     String
  recipients String[]
  body       String
  sentAt     DateTime
  folderId   String?
  isTracked  Boolean          @default(true)
  createdAt  DateTime         @default(now())
  team       Team             @relation(fields: [teamId], references: [id])
  thread     Thread           @relation(fields: [threadId], references: [id])
  folder     EmailFolder?     @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([threadId, externalId])
  @@index([teamId])
  @@index([teamId, sentAt])
  @@index([sentAt])
  @@index([folderId])
  @@index([isTracked])
}

model Evaluation {
  id        String         @id @default(cuid())
  teamId    String
  threadId  String
  type      EvaluationType
  score     Float?
  result    String
  triggered Boolean        @default(false)
  createdAt DateTime       @default(now())
  team      Team           @relation(fields: [teamId], references: [id])
  thread    Thread         @relation(fields: [threadId], references: [id])

  @@index([teamId])
  @@index([threadId])
  @@index([type])
}

model Alert {
  id          String        @id @default(cuid())
  teamId      String
  threadId    String
  severity    AlertSeverity
  title       String
  description String
  resolved    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?
  team        Team          @relation(fields: [teamId], references: [id])
  thread      Thread        @relation(fields: [threadId], references: [id])

  @@index([teamId])
  @@index([severity])
  @@index([resolved])
}

model MonitoringRule {
  id             String         @id @default(cuid())
  teamId         String
  name           String
  evaluationType EvaluationType
  threshold      Float?
  config         Json
  active         Boolean        @default(true)
  scopeKind      RuleScopeKind  @default(TEAM)
  emailAccountId String?
  folderId       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  team           Team           @relation(fields: [teamId], references: [id])
  emailAccount   EmailAccount?  @relation("RuleAccountScope", fields: [emailAccountId], references: [id], onDelete: Cascade)
  folder         EmailFolder?   @relation("RuleFolderScope", fields: [folderId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([teamId, evaluationType, scopeKind])
}

model AuditLog {
  id        String   @id @default(cuid())
  teamId    String
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([teamId])
}

model Plan {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  isActive    Boolean       @default(true)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  features    PlanFeature[]
  users       User[]        @relation("UserCurrentPlan")
}

model PlanFeature {
  id     String @id @default(cuid())
  planId String
  key    String
  value  String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@index([planId])
}

model UsageRecord {
  id        String   @id @default(cuid())
  teamId    String
  metric    String
  quantity  Int
  createdAt DateTime @default(now())

  @@index([teamId])
}

model TeamSettings {
  id                  String  @id @default(uuid())
  teamId              String  @unique
  slaMinutes          Int     @default(560)
  slaEnabled          Boolean @default(false)
  weeklyReportEnabled Boolean @default(false)
  weeklyReportDay     Int?
  notifyOnBreach      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id])
}
